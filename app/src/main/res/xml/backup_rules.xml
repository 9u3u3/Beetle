<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for API 30 and below. API 31+ uses data_extraction_rules.xml instead;
   keep the two in sync.

   Everything Keystore-backed is excluded. The ciphertext is useless on another device (the
   Keystore key never leaves the device it was generated on), so backing it up only risks
   leaking credentials into cloud storage while restoring nothing usable.
-->
<full-backup-content>
    <!-- BYOK Anthropic API key (billable credential) -->
    <exclude domain="sharedpref" path="ai_secrets.xml" />
    <!-- Git SSH private key + username -->
    <exclude domain="sharedpref" path="git_ssh_keys.xml" />
    <!-- Ubuntu-side SSH keys -->
    <exclude domain="sharedpref" path="ubuntu_ssh_keys.xml" />
    <!-- Waitlist authorization state -->
    <exclude domain="sharedpref" path="auth_prefs.xml" />
</full-backup-content>
